# Token của bot (lấy từ @BotFather). Dùng bot RIÊNG cho router, không dùng chung với plugin Telegram.
TELEGRAM_BOT_TOKEN=

# ID Telegram của người được ra lệnh. Bot chạy Claude với toàn quyền trên máy: chỉ để ID của bạn.
# Nhiều ID: cách nhau dấu phẩy.
ALLOWED_USER_IDS=

# ID group (dạng -100...). Để trống lúc đầu: nhắn trong group, bot sẽ báo ID để điền vào đây.
ALLOWED_CHAT_IDS=

# --- Tuỳ chọn ---
# Đường dẫn claude.exe. Để trống: bot tự tìm, và tự tìm lại khi Claude Code cập nhật làm tệp đổi chỗ.
# Đặt thì bot chỉ dùng đúng tệp này, kể cả khi bản cập nhật đổi tên nó: chỉ đặt khi bot không tự tìm được. Đặt trong nháy đơn.
# CLAUDE_BIN='C:\Users\admin\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe'
# Model mặc định cho các topic chưa chọn model bằng /model (để trống: mặc định của Claude Code)
# CLAUDE_MODEL=opus
# Số việc chạy cùng lúc trên toàn bot (mặc định 3)
# MAX_PARALLEL_RUNS=3
# Một việc chạy quá số phút này thì bị dừng (mặc định 60)
# RUN_TIMEOUT_MINUTES=60
# Tin gửi trước khi bot nhận quá số phút này thì bỏ qua (mặc định 10)
# STALE_MESSAGE_MINUTES=10
# Cảnh báo trong topic khi ngữ cảnh của phiên vượt số token này (mặc định 200000, 0 = tắt).
# Phiên trống đã khoảng 57k token (system prompt, tool, skill).
# CONTEXT_WARN_TOKENS=200000
# Cảnh báo khi phiên đã qua số tin này (mặc định 20, 0 = tắt)
# SESSION_WARN_MESSAGES=20
